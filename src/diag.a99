* SPDX-License-Identifier: Apache-2.0
* Tutor/Pyuuta cold-start diagnostic BIOS.
*
* This file is included by one regional wrapper. It uses no stack, no stock
* BIOS service, and no external CPU RAM. The direct-replacement image owns
* on-chip RAM and VRAM, so both are tested destructively.

VDPDAT equ  >e000
VDPCTL equ  >e002
SNDOUT equ  >e200

RESFLG equ  >f000                 * cumulative result bits
STAGE  equ  >f002
FAILAD equ  >f004
FAILXP equ  >f006
FAILAC equ  >f008
FAILMS equ  >f00a
EXTFLG equ  >f00c                 * bit 0: independent Tanam windows
TIMFLG equ  >f00e                 * bit 0: VBlank status transition seen
ROMSUM equ  >f010                 * measured 16 KiB diagnostic-ROM word sum
SOAKCT equ  >f012                 * completed sustained VRAM March passes
KEYHELD equ >f014                 * decoded index+1 while a key is held
KEYCNT equ  >f016                 * distinct key-press count
ROMSM2 equ  >f018                 * reverse-order diagnostic-ROM word sum
VDPSTA equ  >f01a                 * accumulated collision/fifth-sprite status
BURNCT equ  >f01c                 * operator-selected deep-test passes
MENURT equ  >f01e                 * trusted return slot for long menu actions
KEYBUF equ  >f020                 * eight words, one CRU row each
HOLDCT equ  >f030                 * VBlank count for deliberate keyboard exit
JOYBUF equ  >f032                 * selected controller 1/2 raw words
KEYMODE equ >f036                 * zero=native labels, one=PC replacement caps
WFRAME equ  >f038                 * MegaDemo wave frame counter, modulo 1024
WPHASE equ  >f03a                 * MegaDemo signed raster phase accumulator
VDPDLY equ  >f074
ABORTF equ  >f076                 * nonzero when operator presses 0 in a long test
RUNMOD equ  >f078                 * zero=one pass, one=continuous
POLSAV equ  >f07a                 * R12 save for lightweight 0-key polling
TSTPHS equ  >f07c                 * current destructive-test phase (0..4)
SUBRET equ  >f07e                 * return slot for an input-lab child page
SCRADR equ  >f070                 * visible-scrub current VRAM block address
SCRNUM equ  >f072                 * visible-scrub completed 256-byte blocks
ALTWSP equ  >f080
WRKSP  equ  >f0a0

FCPU   equ  >0001
FRAM   equ  >0002
FROM   equ  >0004
FVDP   equ  >0008
FTIME  equ  >0010
FEXT   equ  >0020

NTBASE equ  >0000
SABASE equ  >0300
CTBASE equ  >0380
PTBASE equ  >0800
SPBASE equ  >1800

       aorg >0000
       data WRKSP,START
       data WRKSP,START
       data WRKSP,START
       data WRKSP,FAULT
       data WRKSP,FAULT
       data WRKSP,FAULT
       data WRKSP,FAULT
       data WRKSP,FAULT

       aorg >0100
START  limi 0
       lwpi WRKSP
       bl   @PSGMUT
       bl   @BOOTBP

* Test every ordinary on-chip RAM word by moving the active workspace into a
* block already tested by the first phase. No external RAM or stack is used.
       li   r1,>f000
       li   r2,>0050              * >F000->F09F, includes alternate workspace
       bl   @RAMRNG
       li   r1,>f0c0
       li   r2,>001e              * >F0C0->F0FB
       bl   @RAMRNG
       lwpi ALTWSP
       li   r1,>f0a0
       li   r2,>0010              * original reset workspace
       bl   @RAMRNG
       lwpi WRKSP
       clr  r0
       clr  r1
       clr  r2
       clr  r3
       clr  r4
       clr  r5
       clr  r6
       clr  r7
       clr  r8
       clr  r9
       clr  r10
       clr  r11
       clr  r12
       clr  r13
       clr  r14
       clr  r15
       clr  @RESFLG
       clr  @EXTFLG
       clr  @TIMFLG
       clr  @VDPDLY
       clr  @ROMSUM
       clr  @SOAKCT
       clr  @KEYHELD
       clr  @KEYCNT
       clr  @ROMSM2
       clr  @VDPSTA
       clr  @BURNCT
       clr  @SCRADR
       clr  @SCRNUM
       clr  @ABORTF
       clr  @RUNMOD
       clr  @TSTPHS
       clr  @HOLDCT
       clr  @JOYBUF
       clr  @JOYBUF+2
       clr  @KEYMODE
       clr  @WFRAME
       clr  @WPHASE

       li   r0,>0002
       mov  r0,@STAGE
       bl   @CPUTST
       bl   @ROMTST

       li   r0,>0003
       mov  r0,@STAGE
       bl   @VDPINI
       bl   @VRTEST
       bl   @EXTPRB
       bl   @SCRINI
       bl   @TIMTST
       bl   @SUMMARY
       bl   @PSGTST
       mov  @RESFLG,r0
       jne  BOOTFL
       bl   @PASSBP
       jmp  MENUEN
BOOTFL bl   @FAILBP
       jmp  MENUEN

* ---------------------------------------------------------------------------
* Stable operator menu. Number keys avoid the reported shared bit-2 path.
* ---------------------------------------------------------------------------

MENUEN bl   @SCRINI
       bl   @MENUDR
       bl   @KEYREL
MENULP bl   @KEYSCN
       mov  @KEYBUF,r0
       andi r0,>0100              * 1: system results
       jne  MENU1
       mov  @KEYBUF,r0
       andi r0,>0200              * 2: keyboard/controllers
       jne  MENU2
       mov  @KEYBUF+2,r0
       andi r0,>0100              * 3: VRAM deep test
       jne  MENU3
       mov  @KEYBUF+2,r0
       andi r0,>0200              * 4: VDP showcase
       jne  MENU4
       mov  @KEYBUF+4,r0
       andi r0,>0100              * 5: PSG music
       jne  MENU5
       mov  @KEYBUF+4,r0
       andi r0,>0200              * 6: VRAM chip finder
       jne  MENU6
       mov  @KEYBUF+6,r0
       andi r0,>0100              * 7: optional Tanam 16 KiB RAM test
       jne  MENU7
       mov  @KEYBUF+6,r0
       andi r0,>0200              * 8: credits and acknowledgements
       jne  MENU8
       jmp  MENULP

MENU1  li   r0,>0102
       li   r1,>1600
       bl   @MENUACK
       bl   @KEYREL
       bl   @SCRINI
       bl   @SUMMARY
       bl   @WAIT0
       jmp  MENUEN
MENU2  li   r0,>0142
       li   r1,>1700
       bl   @MENUACK
       bl   @KEYREL
       bl   @INPLAB
       jmp  MENUEN
MENU3  li   r0,>0182
       li   r1,>1800
       bl   @MENUACK
       bl   @KEYREL
       bl   @VRDEEP
       jmp  MENUEN
MENU4  li   r0,>01c2
       li   r1,>1900
       bl   @MENUACK
       bl   @KEYREL
       bl   @VDPSHW
       jmp  MENUEN
MENU5  li   r0,>0202
       li   r1,>1a00
       bl   @MENUACK
       bl   @KEYREL
       bl   @MUSPG
       bl   @PSGMUS
       jmp  MENUEN
MENU6  li   r0,>0242
       li   r1,>1b00
       bl   @MENUACK
       bl   @KEYREL
       bl   @VRCHIP
       bl   @WAIT0
       jmp  MENUEN
MENU7  li   r0,>0282
       li   r1,>1c00
       bl   @MENUACK
       bl   @KEYREL
       bl   @TANRAM
       b    @MENUEN
MENU8  li   r0,>02c2
       li   r1,>1d00
       bl   @MENUACK
       bl   @KEYREL
       bl   @CREDPG
       b    @MENUEN

* Immediate menu acknowledgement: replace only the selected numeral with its
* private bold glyph, play a short TI-style key beep, hold for four frames,
* then mute. KEYREL below leaves the bold numeral visible while a key is held.
MENUACK mov  r11,r10
       bl   @VRW1
       li   r0,>8800
       movb r0,@SNDOUT
       inc  @VDPDLY
       li   r0,>0800
       movb r0,@SNDOUT
       inc  @VDPDLY
       li   r0,>9200
       movb r0,@SNDOUT
       inc  @VDPDLY
       li   r5,4
MENUAVL bl   @VDPVB
       dec  r5
       jne  MENUAVL
       bl   @PSGMUT
       b    *r10

CREDPG mov  r11,r12
       bl   @SCRINI
       li   r1,CREDTT
       bl   @PUTTTL
       li   r4,CREDTB
       li   r5,7
CREDLP mov  *r4+,r0
       mov  *r4+,r1
       bl   @PUTSTR
       dec  r5
       jne  CREDLP
       li   r0,>02c6
       li   r1,BACKT
       bl   @PUTSTR
       bl   @WAIT0
       b    *r12

* Wait until every input is released. This keeps a menu press from repeating.
KEYREL mov  r11,r13
KEYRLP bl   @KEYSCN
       li   r1,KEYBUF
       li   r2,8
       clr  r0
KEYROR soc  *r1+,r0
       dec  r2
       jne  KEYROR
       mov  r0,r0
       jne  KEYRLP
       b    *r13

* Wait for the PC/Tutor/Pyuuta 0 contact (row 4, bit 0), then release it.
WAIT0  mov  r11,r15
WAIT0L bl   @KEYSCN
       mov  @KEYBUF+8,r0
       andi r0,>0100
       jeq  WAIT0L
       bl   @KEYREL
       b    *r15

* Lightweight row-4/bit-0 poll for long-running tests and music. Unlike a full
* matrix scan it preserves every loop register except R0/R1 and sets ABORTF.
POLL0  mov  r11,r15
       mov  r12,@POLSAV
       li   r12,>ec40
       clr  r0
       stcr r0,8
       mov  @POLSAV,r12
       andi r0,>0100
       jeq  POLLRT
       li   r1,1
       mov  r1,@ABORTF
POLLRT b    *r15

* ---------------------------------------------------------------------------
* Early CPU/on-chip RAM tests
* ---------------------------------------------------------------------------

* R1=start, R2=word count. Address-dependent data plus four fixed patterns
* catch data, cell, and common alias faults before the range is trusted.
RAMRNG mov  r11,r10
       mov  r1,r4
       mov  r2,r5
       li   r6,>a55a
RAMADW mov  r1,r7
       xor  r6,r7
       mov  r7,*r1+
       dec  r2
       jne  RAMADW
       mov  r4,r1
       mov  r5,r2
RAMADR mov  r1,r7
       xor  r6,r7
       c    *r1,r7
       jne  RAMBAD
       inct r1
       dec  r2
       jne  RAMADR
       clr  r8
RAMPAT mov  r4,r1
       mov  r5,r2
       mov  @RPATS(r8),r6
RAMPW  mov  r6,*r1+
       dec  r2
       jne  RAMPW
       mov  r4,r1
       mov  r5,r2
RAMPR  c    *r1,r6
       jne  RAMBAD
       inct r1
       dec  r2
       jne  RAMPR
       inct r8
       ci   r8,8
       jne  RAMPAT
       b    *r10
RAMBAD mov  r1,r0
       li   r1,FRAM
       jmp  EARLYF

RPATS  data >0000,>ffff,>aaaa,>5555

CPUTST li   r0,>1234
       ai   r0,>1111
       ci   r0,>2345
       jne  CPUBAD
       mov  r0,r1
       xor  @CPUXOR,r1
       ci   r1,>d3ba
       jne  CPUBAD
       sla  r0,1
       ci   r0,>468a
       jne  CPUBAD
       inv  r0
       ci   r0,>b975
       jne  CPUBAD
       rt
CPUBAD mov  r0,@FAILAC
       li   r1,FCPU
       soc  r1,@RESFLG
       rt
CPUXOR data >f0ff

* The build patches >3FFC so the unsigned sum of all 8192 big-endian words is
* zero. Read it in both directions: a stable equal nonzero pair points to the
* wrong image/bank, while unequal readings point toward an unstable ROM path.
ROMTST clr  r0
       clr  r1
       li   r2,>2000
ROMTSL a    *r1+,r0
       dec  r2
       jne  ROMTSL
       mov  r0,@ROMSUM
       clr  r3
       li   r1,>3ffe
       li   r2,>2000
ROMTSR a    *r1,r3
       dect r1
       dec  r2
       jne  ROMTSR
       mov  r3,@ROMSM2
       mov  r0,r2
       soc  r3,r2
       jne  ROMBAD
       c    r0,r3
       jeq  ROMTOK
ROMBAD
       li   r1,FROM
       soc  r1,@RESFLG
ROMTOK rt

* R0=failing address, R1=stage flag. The active workspace is the only writable
* resource assumed. Border and PSG attempts are deliberately redundant.
EARLYF mov  r0,@FAILAD
       mov  r1,@RESFLG
       mov  r1,@STAGE
FAULT movb @VDPCTL,r0            * reset an unknown VDP control latch state
       li   r0,>f687              * red border if the VDP control path works
       bl   @VDPREGW
       bl   @FAILBP
       jmp  FAULT

* ---------------------------------------------------------------------------
* VDP/VRAM tests
* ---------------------------------------------------------------------------

VDPINI movb @VDPCTL,r0
       li   r1,VDPREG
       li   r2,16
VDPILP movb *r1+,@VDPCTL
       inc  @VDPDLY
       dec  r2
       jne  VDPILP
       rt

VRTEST mov  r11,r13
       clr  @FAILAD
       clr  @FAILXP
       clr  @FAILAC
       clr  @FAILMS

* Data path at address zero: fixed and walking patterns.
       li   r4,VRPATS
       li   r5,20
VRDTLP clr  r0
       clr  r1
       movb *r4+,r1
       bl   @VRW1
       clr  r0
       bl   @VRR1
       cb   r1,r2
       jeq  VRDTOK
       b    @VRBAD
VRDTOK
       dec  r5
       jne  VRDTLP

* Address path: clear all VRAM, write distinct sentinels to 1<<A0..A13, then
* verify them. Aliased address lines overwrite a different expected marker.
       clr  r1
       bl   @VRFILL
       li   r6,1
       li   r7,>0100
       li   r8,14
VRAWW  mov  r6,r0
       mov  r7,r1
       bl   @VRW1
       sla  r6,1
       ai   r7,>0100
       dec  r8
       jne  VRAWW
       clr  r0
       bl   @VRR1
       mov  r2,r2
       jeq  VRAZOK
       b    @VRBAD0
VRAZOK
       li   r6,1
       li   r7,>0100
       li   r8,14
VRAWR  mov  r6,r0
       bl   @VRR1
       cb   r7,r2
       jeq  VRAAOK
       b    @VRBADA
VRAAOK
       sla  r6,1
       ai   r7,>0100
       dec  r8
       jne  VRAWR

* Full 16 KiB sweeps exercise every cell and every data lane.
       li   r4,VFPATS
       li   r5,4
VRFPLP clr  r1
       movb *r4+,r1
       bl   @VRFILL
       bl   @VRVER
       dec  r5
       jne  VRFPLP
       b    *r13

* Destructive 17N March-B, chosen after review of DesTestMAX's documented
* strategy: {w0; up(r0,w1,r1,w0,r0,w1); up(r1,w0,w1);
* down(r1,w0,w1,w0); down(r0,w1,w0)}. VRAM has no decrement mode,
* so every operation explicitly sets the address. The live display is never
* blanked: VRAM contents themselves become the visible test pattern.
VRMARCH mov  r11,r13
       clr  @TSTPHS
       li   r0,>4487              * M0: blue border, initialize 0
       bl   @VDPREGW
       clr  r1
       bl   @VRFILL

* M1 ascending: r0,w1,r1,w0,r0,w1.
       li   r0,>4787              * cyan border
       bl   @VDPREGW
       li   r0,1
       mov  r0,@TSTPHS
       clr  r4
       li   r5,>4000
       li   r7,>0100
VRMB1  mov  r4,r0
       bl   @VRR1
       mov  r2,r2
       jeq  VRM1A
       b    @VRMBZ
VRM1A
       mov  r4,r0
       li   r1,>ff00
       bl   @VRW1
       mov  r4,r0
       bl   @VRR1
       li   r6,>ff00
       cb   r6,r2
       jeq  VRM1B
       b    @VRMBAD
VRM1B
       mov  r4,r0
       clr  r1
       bl   @VRW1
       mov  r4,r0
       bl   @VRR1
       mov  r2,r2
       jeq  VRM1C
       b    @VRMBZ
VRM1C
       mov  r4,r0
       li   r1,>ff00
       bl   @VRW1
       inc  r4
       dec  r5
       jeq  VRMB1D
       dec  r7
       jne  VRMB1
       bl   @POLL0
       mov  r0,r0
       jeq  VRM1D
       b    @VRMAB
VRM1D
       li   r7,>0100
       jmp  VRMB1
VRMB1D

* M2 ascending: r1,w0,w1.
       li   r0,>4587              * light-blue border
       bl   @VDPREGW
       li   r0,2
       mov  r0,@TSTPHS
       clr  r4
       li   r5,>4000
       li   r7,>0100
VRMB2  mov  r4,r0
       bl   @VRR1
       li   r6,>ff00
       cb   r6,r2
       jne  VRMBAD
       mov  r4,r0
       clr  r1
       bl   @VRW1
       mov  r4,r0
       li   r1,>ff00
       bl   @VRW1
       inc  r4
       dec  r5
       jeq  VRMB2D
       dec  r7
       jne  VRMB2
       bl   @POLL0
       mov  r0,r0
       jne  VRMAB
       li   r7,>0100
       jmp  VRMB2
VRMB2D

* M3 descending: r1,w0,w1,w0.
       li   r0,>4a87              * amber border
       bl   @VDPREGW
       li   r0,3
       mov  r0,@TSTPHS
       li   r4,>3fff
       li   r5,>4000
       li   r7,>0100
VRMB3  mov  r4,r0
       bl   @VRR1
       li   r6,>ff00
       cb   r6,r2
       jne  VRMBAD
       mov  r4,r0
       clr  r1
       bl   @VRW1
       mov  r4,r0
       li   r1,>ff00
       bl   @VRW1
       mov  r4,r0
       clr  r1
       bl   @VRW1
       dec  r4
       dec  r5
       jeq  VRMB3D
       dec  r7
       jne  VRMB3
       bl   @POLL0
       mov  r0,r0
       jne  VRMAB
       li   r7,>0100
       jmp  VRMB3
VRMB3D

* M4 descending: r0,w1,w0.
       li   r0,>4c87              * dark-green border
       bl   @VDPREGW
       li   r0,4
       mov  r0,@TSTPHS
       li   r4,>3fff
       li   r5,>4000
       li   r7,>0100
VRMB4  mov  r4,r0
       bl   @VRR1
       mov  r2,r2
       jne  VRMBZ
       mov  r4,r0
       li   r1,>ff00
       bl   @VRW1
       mov  r4,r0
       clr  r1
       bl   @VRW1
       dec  r4
       dec  r5
       jeq  VRMB4D
       dec  r7
       jne  VRMB4
       bl   @POLL0
       mov  r0,r0
       jne  VRMAB
       li   r7,>0100
       jmp  VRMB4
VRMB4D
       li   r0,5
       mov  r0,@TSTPHS
       li   r0,>4287              * green border: pass
       bl   @VDPREGW
       b    *r13
VRMAB  b    *r13
VRMBZ  clr  r6
VRMBAD mov  r6,r1
       mov  r4,r0
       b    @VRBAD

* Local March-B over one 256-byte block at R8. Used only by the visible scrub.
VRBLK  mov  r11,r13
       mov  r8,r4
       li   r5,>0100
VRB0   mov  r4,r0
       clr  r1
       bl   @VRW1
       inc  r4
       dec  r5
       jne  VRB0

       mov  r8,r4
       li   r5,>0100
VRB1   mov  r4,r0
       bl   @VRR1
       clr  r6
       cb   r6,r2
       jne  VRBBAD
       mov  r4,r0
       li   r1,>ff00
       bl   @VRW1
       mov  r4,r0
       bl   @VRR1
       li   r6,>ff00
       cb   r6,r2
       jne  VRBBAD
       mov  r4,r0
       clr  r1
       bl   @VRW1
       mov  r4,r0
       bl   @VRR1
       clr  r6
       cb   r6,r2
       jne  VRBBAD
       mov  r4,r0
       li   r1,>ff00
       bl   @VRW1
       inc  r4
       dec  r5
       jne  VRB1

       mov  r8,r4
       li   r5,>0100
VRB2   mov  r4,r0
       bl   @VRR1
       li   r6,>ff00
       cb   r6,r2
       jne  VRBBAD
       mov  r4,r0
       clr  r1
       bl   @VRW1
       mov  r4,r0
       li   r1,>ff00
       bl   @VRW1
       inc  r4
       dec  r5
       jne  VRB2

       mov  r8,r4
       ai   r4,>00ff
       li   r5,>0100
VRB3   mov  r4,r0
       bl   @VRR1
       li   r6,>ff00
       cb   r6,r2
       jne  VRBBAD
       mov  r4,r0
       clr  r1
       bl   @VRW1
       mov  r4,r0
       li   r1,>ff00
       bl   @VRW1
       mov  r4,r0
       clr  r1
       bl   @VRW1
       dec  r4
       dec  r5
       jne  VRB3

       mov  r8,r4
       ai   r4,>00ff
       li   r5,>0100
VRB4   mov  r4,r0
       bl   @VRR1
       clr  r6
       cb   r6,r2
       jne  VRBBAD
       mov  r4,r0
       li   r1,>ff00
       bl   @VRW1
       mov  r4,r0
       clr  r1
       bl   @VRW1
       dec  r4
       dec  r5
       jne  VRB4
       b    *r13
VRBBAD mov  r6,r1
       mov  r4,r0
       jmp  VRBAD

VRBAD0 clr  r0
       clr  r1
       jmp  VRBAD
VRBADA mov  r6,r0
       mov  r7,r1
VRBAD  mov  r0,@FAILAD
       mov  r1,@FAILXP
       mov  r2,@FAILAC
       mov  r1,r3
       xor  r2,r3
       mov  r3,@FAILMS
       li   r3,FVDP
       soc  r3,@RESFLG
       b    *r13

* R1 high byte is the fill/expected value.
VRFILL mov  r11,r10
       clr  r0
       bl   @SETAW
       li   r2,>4000
VRFLP  movb r1,@VDPDAT
       inc  @VDPDLY
       dec  r2
       jne  VRFLP
       b    *r10

VRVER  mov  r11,r10
       clr  r0
       bl   @SETAR
       li   r3,>4000
       clr  r0
VRVLP  movb @VDPDAT,r2
       inc  @VDPDLY
       cb   r1,r2
       jne  VRVBD
       inc  r0
       dec  r3
       jne  VRVLP
       b    *r10
VRVBD  jmp  VRBAD

* R0=VRAM address, R1 high byte=data.
VRW1   mov  r11,r9
       bl   @SETAW
       movb r1,@VDPDAT
       inc  @VDPDLY
       b    *r9

* R0=VRAM address, result R2 high byte.
VRR1   mov  r11,r9
       bl   @SETAR
       clr  r2
       movb @VDPDAT,r2
       inc  @VDPDLY
       b    *r9

SETAW  mov  r0,r3
       swpb r3
       movb r3,@VDPCTL
       inc  @VDPDLY
       mov  r0,r3
       andi r3,>3f00
       ori  r3,>4000
       movb r3,@VDPCTL
       inc  @VDPDLY
       rt

SETAR  mov  r0,r3
       swpb r3
       movb r3,@VDPCTL
       inc  @VDPDLY
       mov  r0,r3
       andi r3,>3f00
       movb r3,@VDPCTL
       inc  @VDPDLY
       rt

VRPATS byte >00,>ff,>aa,>55,>01,>02,>04,>08,>10,>20,>40,>80
       byte >fe,>fd,>fb,>f7,>ef,>df,>bf,>7f
VFPATS byte >00,>ff,>aa,>55
       even

* ---------------------------------------------------------------------------
* Optional extension discovery
* ---------------------------------------------------------------------------

* Save one word in each candidate window, write complementary patterns,
* verify they remain independent, and restore before setting a result flag.
EXTPRB mov  @>6000,r4
       mov  @>c000,r5
       li   r6,>35ac
       li   r7,>ca53
       mov  r6,@>6000
       c    @>6000,r6
       jne  EXTNO
       mov  r7,@>c000
       mov  @>6000,r8
       mov  @>c000,r9
       mov  r4,@>6000
       mov  r5,@>c000
       c    r8,r6
       jne  EXTNO2
       c    r9,r7
       jne  EXTNO2
       li   r0,1
       mov  r0,@EXTFLG
       rt
EXTNO  mov  r4,@>6000
       mov  r5,@>c000
* Absence is normal: clear only the presence flag, never the failure flags.
EXTNO2 clr  @EXTFLG
       rt

* ---------------------------------------------------------------------------
* Presentation, timing, keyboard, and controller viewer
* ---------------------------------------------------------------------------

MENUDR mov  r11,r12
       li   r0,>4f87              * Tomy-inspired dark-blue on white theme
       bl   @VDPREGW
       li   r1,BRANDT
       bl   @PUTTTL
       li   r0,>0022
       li   r1,DIAGT
       bl   @PUTSTR
       li   r0,>0042
       li   r1,URLT
       bl   @PUTSTR
       li   r0,>0062
       li   r1,EXPERM
       bl   @PUTSTR
       li   r0,>00a2
       li   r1,REGIONT
       bl   @PUTSTR
       li   r0,>00aa
       .ifeq REGION,>0000
       li   r1,TUTORT
       .else
       li   r1,PYUUTT
       .endif
       bl   @PUTSTR
       li   r0,>00c2
       li   r1,EXTTXT
       bl   @PUTSTR
       li   r0,>00ca
       li   r1,NOEXTT
       mov  @EXTFLG,r2
       jeq  MENUEX
       li   r1,TANAMT
MENUEX bl   @PUTSTR
       li   r0,>0102
       li   r1,MENU1T
       bl   @PUTSTR
       li   r0,>0142
       li   r1,MENU2T
       bl   @PUTSTR
       li   r0,>0182
       li   r1,MENU3T
       bl   @PUTSTR
       li   r0,>01c2
       li   r1,MENU4T
       bl   @PUTSTR
       li   r0,>0202
       li   r1,MENU5T
       bl   @PUTSTR
       li   r0,>0242
       li   r1,MENU6T
       bl   @PUTSTR
       li   r0,>0282
       li   r1,MENU7T
       bl   @PUTSTR
       li   r0,>02c2
       li   r1,MENU8T
       bl   @PUTSTR
       mov  @RESFLG,r0
       jeq  MENUGR
       li   r0,>4687              * real failures alone get a red border
       jmp  MENUBD
MENUGR li   r0,>4487
MENUBD bl   @VDPREGW
       b    *r12

* Keyboard and rear controllers use different CRU selection paths. Their
* operator views also stay on separate pages so neither live display crowds
* or overwrites the other.
INPLAB mov  r11,@MENURT
INPDR  bl   @SCRINI
       li   r1,INPTTL
       bl   @PUTTTL
       li   r0,>0083
       li   r1,INPKBD
       bl   @PUTSTR
       li   r0,>00c3
       li   r1,INPJOY
       bl   @PUTSTR
       li   r0,>0103
       li   r1,INPBACK
       bl   @PUTSTR
INPKEY bl   @KEYSCN
       mov  @KEYBUF,r0
       andi r0,>0100
       jne  INPKGO
       mov  @KEYBUF,r0
       andi r0,>0200
       jne  INPJGO
       mov  @KEYBUF+8,r0
       andi r0,>0100
       jeq  INPKEY
       bl   @KEYREL
       mov  @MENURT,r11
       b    *r11
INPKGO bl   @KEYREL
       bl   @KBDPG
       jmp  INPDR
INPJGO bl   @KEYREL
       bl   @JOYPG
       jmp  INPDR

KBDPG  mov  r11,@SUBRET
       clr  @KEYHELD
       clr  @KEYCNT
       clr  @HOLDCT
       clr  @KEYMODE              * regional native view is the safe default
KBDRDR
       bl   @SCRINI
       li   r1,KBDTTL
       bl   @PUTTTL
       li   r0,>0042
       li   r1,REGIONT
       bl   @PUTSTR
       li   r0,>004a
       .ifeq REGION,>0000
       li   r1,TUTORT
       .else
       li   r1,PYUUTT
       .endif
       bl   @PUTSTR
       li   r0,>0062
       li   r1,VIEWTX
       bl   @PUTSTR
       li   r0,>0068
       li   r1,PCVIEW
       mov  @KEYMODE,r2
       jne  KBDVIW
       .ifeq REGION,>0000
       li   r1,TUTORT
       .else
       li   r1,PYUUTT
       .endif
KBDVIW bl   @PUTSTR
       li   r0,>0082
       li   r1,LASTTX
       bl   @PUTSTR
       li   r0,>0088
       li   r1,NOKEYT
       bl   @PUTSTR
       li   r0,>0099
       li   r1,HASHTX
       bl   @PUTSTR
       li   r0,>009a
       clr  r1
       bl   @PUTHEX
       li   r0,>00c2
       li   r1,RAWTTL
       bl   @PUTSTR
       li   r0,>0102
       li   r1,KEY0T
       bl   @PUTSTR
       li   r0,>0142
       li   r1,KEY1T
       bl   @PUTSTR
       li   r0,>0182
       li   r1,KEY2T
       bl   @PUTSTR
       li   r0,>01c2
       li   r1,KEY3T
       bl   @PUTSTR
       li   r0,>0242
       li   r1,KBDHELP
       bl   @PUTSTR
       li   r0,>02c2
       li   r1,FOOTTX
       bl   @PUTSTR
KBDLOP bl   @KEYUPD
       mov  @KEYBUF+8,r0
       andi r0,>0100
       jeq  KBDMOD
       mov  @KEYBUF+12,r0         * Shift+zero is '=' on the native map
       andi r0,>0400              * and cannot be the page-exit gesture
       jne  KBDMOD
       bl   @VDPVB
       inc  @HOLDCT
       mov  @HOLDCT,r0
       ci   r0,60                 * approximately one second at 60 Hz
       jl   KBDLOP
       bl   @KEYREL
       mov  @SUBRET,r11
       b    *r11
KBDMOD mov  @KEYBUF+12,r0
       andi r0,>4000              * MOD is R6B6
       jeq  KBDARM
       bl   @VDPVB
       inc  @HOLDCT
       mov  @HOLDCT,r0
       ci   r0,60                 * quick MOD remains an ordinary test press
       jl   KBDLOP
       mov  @KEYMODE,r0
       inv  r0
       andi r0,1
       mov  r0,@KEYMODE
       clr  @HOLDCT
       bl   @KEYREL               * one deliberate toggle per hold
       b    @KBDRDR
KBDARM clr  @HOLDCT
       jmp  KBDLOP

JOYPG  mov  r11,@SUBRET
       bl   @SCRINI
       li   r1,JOYTTL
       bl   @PUTTTL
       li   r0,>0042
       li   r1,JOYNOTE
       bl   @PUTSTR
       li   r0,>00a2
       li   r1,JOY1T
       bl   @PUTSTR
       li   r0,>00c2
       li   r1,JOYRAW
       bl   @PUTSTR
       li   r0,>00ca
       clr  r1
       bl   @PUTHEX
       li   r0,>0102
       li   r1,JOYLEG
       bl   @PUTSTR
       li   r0,>0162
       li   r1,JOY2T
       bl   @PUTSTR
       li   r0,>0182
       li   r1,JOYRAW
       bl   @PUTSTR
       li   r0,>018a
       clr  r1
       bl   @PUTHEX
       li   r0,>01c2
       li   r1,JOYLEG
       bl   @PUTSTR
       li   r0,>0242
       li   r1,JOYHELP
       bl   @PUTSTR
       li   r0,>02c2
       li   r1,BACKT
       bl   @PUTSTR
JOYLOP bl   @JOYUPD
       mov  @KEYBUF+8,r0
       andi r0,>0100
       jeq  JOYLOP
       bl   @KEYREL
       mov  @SUBRET,r11
       b    *r11

JOYUPD mov  r11,r15
       bl   @JOYSCN
       mov  @JOYBUF,r1
       srl  r1,8
       li   r0,>00ca
       bl   @PUTHEX
       mov  @JOYBUF+2,r1
       srl  r1,8
       li   r0,>018a
       bl   @PUTHEX
       mov  @JOYBUF,r6
       li   r7,JOY1PS
       bl   @JOYBIT
       mov  @JOYBUF+2,r6
       li   r7,JOY2PS
       bl   @JOYBIT
       bl   @KEYSCN               * keyboard 0 remains the page exit control
       b    *r15

JOYBIT mov  r11,r13
       li   r5,JOYMASK            * fire, left, right, down, up
       li   r8,5
JOYBLP li   r1,>2d00              * '-' means open
       mov  *r5+,r4
       coc  r4,r6
       jne  JOYBOF
       li   r1,>3100              * '1' means asserted
JOYBOF mov  *r7+,r0
       bl   @VRW1
       dec  r8
       jne  JOYBLP
       b    *r13

* The Tutor/Pyuuta controllers are physical input-matrix rows, not a TI-style
* output-selected multiplexer. The stock BIOS and physically exercised shim
* read port 1 at >EC40 and port 2 at >EC50. Bits are asserted high:
* D,L,U,R at bits 4..7, SL/fire at bit 2, and SR at bit 3.
JOYSCN mov  r11,r14
       li   r12,>ec40
       li   r8,JOYBUF
       clr  r0
       stcr r0,8
       mov  r0,*r8+
       li   r12,>ec50
       clr  r0
       stcr r0,8
       mov  r0,*r8+
       b    *r14

* VRAM test lab: choose a GUI-restoring chunk scrub or strict whole-memory
* March-B. They are separate because repainting between March elements would
* invalidate the state and cross-block coupling coverage of the strict test.
VRDEEP mov  r11,@MENURT
VRLAB  bl   @SCRINI
       li   r1,VRLTTL
       bl   @PUTTTL
       li   r0,>0062
       li   r1,VRLL1
       bl   @PUTSTR
       li   r0,>00a2
       li   r1,VRLL2
       bl   @PUTSTR
       li   r0,>00e2
       li   r1,VRLL5
       bl   @PUTSTR
       li   r0,>0142
       li   r1,VRLL3
       bl   @PUTSTR
       li   r0,>0182
       li   r1,VRLL4
       bl   @PUTSTR
       li   r0,>02c6
       li   r1,BACKT
       bl   @PUTSTR
VRLKEY bl   @KEYSCN
       mov  @KEYBUF,r0
       andi r0,>0100
       jeq  VRLK2
       b    @VRSCRB
VRLK2
       mov  @KEYBUF,r0
       andi r0,>0200
       jne  VRDFUL
       mov  @KEYBUF+2,r0
       andi r0,>0100
       jne  VRDCON
       mov  @KEYBUF+8,r0
       andi r0,>0100
       jeq  VRLKEY
       bl   @KEYREL
       mov  @MENURT,r11
       b    *r11
VRDFUL clr  @RUNMOD
       jmp  VRDWAR
VRDCON li   r0,1
       mov  r0,@RUNMOD
VRDWAR bl   @KEYREL
       bl   @SCRINI
       li   r1,VRWTTL
       bl   @PUTTTL
       li   r0,>0063
       li   r1,VRWCOL
       bl   @PUTSTR
       li   r0,>00a2
       li   r1,VRWPAU
       bl   @PUTSTR
       li   r0,>00e3
       li   r1,VRWERR
       bl   @PUTSTR
       li   r0,>0122
       li   r1,VRWRST
       bl   @PUTSTR
       li   r0,>0186
       li   r1,VRWAUT
       bl   @PUTSTR
       li   r0,>01ca
       li   r1,VRWCD
       bl   @PUTSTR
       li   r0,>02c6
       li   r1,BACKT
       bl   @PUTSTR
       clr  @ABORTF
       li   r6,3                 * readable three-second safety countdown
VRDWCS mov  r6,r1
       sla  r1,8
       ai   r1,>3000
       li   r0,>01d5
       bl   @VRW1
       li   r5,60
VRDWCL bl   @VDPVB
       bl   @POLL0
       mov  r0,r0
       jne  VRDWCN
       dec  r5
       jne  VRDWCL
       dec  r6
       jne  VRDWCS
       jmp  VRDGO
VRDWCN bl   @KEYREL
       b    @VRLAB
VRDGO  bl   @KEYREL
       clr  @BURNCT
VRDAGN bl   @SCRINI
       li   r1,VRDTTL
       bl   @PUTTTL
       li   r0,>0062
       li   r1,VRDL1
       bl   @PUTSTR
       li   r0,>00a2
       li   r1,VRDL2
       bl   @PUTSTR
       li   r0,>00e2
       li   r1,VRDL3
       bl   @PUTSTR
       li   r0,>0122
       li   r1,VRDL4
       bl   @PUTSTR
       li   r0,>0162
       li   r1,VRDL5
       bl   @PUTSTR
       li   r0,>0183
       li   r1,VRDWAIT
       bl   @PUTSTR
       mov  @BURNCT,r0            * only pause on entry, not every repeat pass
       jne  VRDPDN
       li   r5,120                * about two seconds at 60 Hz; no second count
VRDPRE bl   @VDPVB
       dec  r5
       jne  VRDPRE
VRDPDN
       clr  @FAILAD
       clr  @FAILXP
       clr  @FAILAC
       clr  @FAILMS
       li   r0,FVDP
       szc  r0,@RESFLG
       clr  @ABORTF
       bl   @VRMARCH
       mov  @ABORTF,r0
       jeq  VRDCHK
       bl   @KEYREL
       jmp  VRDRES
VRDCHK
       mov  @RESFLG,r0
       andi r0,FVDP
       jne  VRDRES
       inc  @BURNCT
       mov  @RUNMOD,r0
       jne  VRDAGN
VRDRES bl   @SCRINI
       li   r1,VRDRTTL
       bl   @PUTTTL
       li   r0,>0064
       li   r1,VRDRSL
       bl   @PUTSTR
       li   r0,>0076
       li   r1,PASSTX
       mov  @ABORTF,r2
       jeq  VRDRF
       li   r1,STOPTX
       jmp  VRDRP
VRDRF
       mov  @RESFLG,r2
       andi r2,FVDP
       jeq  VRDRP
       li   r1,FAILTX
VRDRP  bl   @PUTSTR
       li   r0,>00a4
       li   r1,VADRTX
       bl   @PUTSTR
       li   r0,>00b6
       mov  @FAILAD,r1
       bl   @PUTHEX
       li   r0,>00e4
       li   r1,VMASKT
       bl   @PUTSTR
       li   r0,>00f6
       mov  @FAILMS,r1
       bl   @PUTHEX
       li   r0,>0124
       li   r1,PASCTT
       bl   @PUTSTR
       li   r0,>0136
       mov  @BURNCT,r1
       bl   @PUTHEX
       li   r0,>0183
       li   r1,VRDRUN
       bl   @PUTSTR
       li   r0,>01a3
       li   r1,VRDMNU
       bl   @PUTSTR
VRDKEY bl   @KEYSCN
       mov  @KEYBUF,r0
       andi r0,>0200              * 2 runs one complete pass
       jeq  VRDK3
       bl   @KEYREL
       clr  @RUNMOD
       b    @VRDGO
VRDK3
       mov  @KEYBUF+2,r0
       andi r0,>0100              * 3 runs continuously
       jeq  VRDK0
       bl   @KEYREL
       li   r0,1
       mov  r0,@RUNMOD
       b    @VRDGO
VRDK0
       mov  @KEYBUF+8,r0
       andi r0,>0100
       jeq  VRDKEY
       bl   @KEYREL
       mov  @MENURT,r11
       b    *r11

* GUI-restoring scrub: local 17N March-B on each 256-byte block. The screen is
* rebuilt from ROM before every block, so overwritten text/patterns return.
* This covers every byte but is intentionally not claimed as whole-array
* inter-block coupling coverage; option 2 provides that strict test.
VRSCRB bl   @KEYREL
       clr  @ABORTF
       clr  @SCRADR
       clr  @SCRNUM
       clr  @FAILAD
       clr  @FAILXP
       clr  @FAILAC
       clr  @FAILMS
       li   r0,FVDP
       szc  r0,@RESFLG
VRSCLP bl   @SCRINI
       li   r1,VRSCTT
       bl   @PUTTTL
       li   r0,>0063
       li   r1,VRSCL1
       bl   @PUTSTR
       li   r0,>00a4
       li   r1,VRSCA
       bl   @PUTSTR
       li   r0,>00b8
       mov  @SCRADR,r1
       bl   @PUTHEX
       li   r0,>00e4
       li   r1,VRSCN
       bl   @PUTSTR
       li   r0,>00f8
       mov  @SCRNUM,r1
       bl   @PUTHEX
       li   r0,>02c3
       li   r1,VRDL5
       bl   @PUTSTR
       bl   @VDPVB
       mov  @SCRADR,r8
       bl   @VRBLK
       bl   @POLL0
       mov  r0,r0
       jne  VRSCDN
       mov  @RESFLG,r0
       andi r0,FVDP
       jne  VRSCDN
       inc  @SCRNUM
       mov  @SCRADR,r0
       ai   r0,>0100
       mov  r0,@SCRADR
       mov  @SCRNUM,r0
       ci   r0,64
       jl   VRSCLP
VRSCDN bl   @SCRINI
       li   r1,VRSCRT
       bl   @PUTTTL
       li   r0,>0062
       li   r1,VRDRSL
       bl   @PUTSTR
       li   r0,>0077
       li   r1,PASSTX
       mov  @ABORTF,r2
       jeq  VRSCRF
       li   r1,STOPTX
       jmp  VRSCP
VRSCRF
       mov  @RESFLG,r2
       andi r2,FVDP
       jeq  VRSCP
       li   r1,FAILTX
VRSCP  bl   @PUTSTR
       li   r0,>00a4
       li   r1,VADRTX
       bl   @PUTSTR
       li   r0,>00b8
       mov  @FAILAD,r1
       bl   @PUTHEX
       li   r0,>00e4
       li   r1,VMASKT
       bl   @PUTSTR
       li   r0,>00f8
       mov  @FAILMS,r1
       bl   @PUTHEX
       li   r0,>0142
       li   r1,VRSCOV
       bl   @PUTSTR
       li   r0,>0182
       li   r1,VRSCBK
       bl   @PUTSTR
       li   r0,>02c6
       li   r1,BACKT
       bl   @PUTSTR
       bl   @WAIT0
       b    @VRLAB

* Board-revision-qualified bit-lane lookup. Draw the physical 2x4 DRAM bank
* as chip packages; a star inside a package marks each failing data lane.
VRCHIP mov  r11,r12
       bl   @SCRINI
       li   r1,CHIPTT
       bl   @PUTTTL
       li   r0,>0043
       li   r1,CHIPM1
       bl   @PUTSTR
       li   r0,>004e
       mov  @FAILMS,r1
       bl   @PUTHEX
       li   r0,>0063
       li   r1,CHIPA1
       bl   @PUTSTR
       li   r0,>006e
       mov  @FAILAD,r1
       bl   @PUTHEX
       li   r0,>0083
       li   r1,CHIPLEG
       bl   @PUTSTR
       li   r0,>00a7
       li   r1,CHIPSTAR
       bl   @PUTSTR
       li   r0,>00c1
       li   r1,CHIPBT
       bl   @PUTSTR
       li   r0,>00e1
       li   r1,CHIP01
       bl   @PUTSTR
       li   r0,>0101
       li   r1,CHIPBB
       bl   @PUTSTR
       li   r0,>0121
       li   r1,CHIPBT
       bl   @PUTSTR
       li   r0,>0141
       li   r1,CHIP23
       bl   @PUTSTR
       li   r0,>0161
       li   r1,CHIPBB
       bl   @PUTSTR
       li   r0,>0181
       li   r1,CHIPBT
       bl   @PUTSTR
       li   r0,>01a1
       li   r1,CHIP45
       bl   @PUTSTR
       li   r0,>01c1
       li   r1,CHIPBB
       bl   @PUTSTR
       li   r0,>01e1
       li   r1,CHIPBT
       bl   @PUTSTR
       li   r0,>0201
       li   r1,CHIP67
       bl   @PUTSTR
       li   r0,>0221
       li   r1,CHIPBB
       bl   @PUTSTR
       bl   @CHIPMK
       li   r0,>0263
       li   r1,CHIPRV
       bl   @PUTSTR
       li   r0,>0283
       li   r1,CHIPWN
       bl   @PUTSTR
       li   r0,>02c6
       li   r1,BACKT
       bl   @PUTSTR
       mov  @FAILMS,r0
       jeq  CHIPRT
       li   r0,>4687              * a diagnosed lane keeps the failure border
       bl   @VDPREGW
CHIPRT
       b    *r12

CHIPMK mov  r11,r13
       mov  @FAILMS,r6
       li   r7,CHIPPS
       li   r5,>0100
       li   r8,8
CHIPML mov  *r7+,r0
       coc  r5,r6
       jne  CHIPMN
       li   r1,>2a00              * star inside every suspected package
       bl   @VRW1
CHIPMN sla  r5,1
       dec  r8
       jne  CHIPML
       b    *r13

* Optional destructive 17N March-B across both physically proven independent
* Tanam windows. Discovery alone never calls this path; key 7 confirms twice.
TANRAM mov  r11,@MENURT
       bl   @SCRINI
       li   r1,TANTTL
       bl   @PUTTTL
       mov  @EXTFLG,r0
       jne  TANASK
       li   r0,>0082
       li   r1,TANNO
       bl   @PUTSTR
       li   r0,>00c2
       li   r1,TANSKIP
       bl   @PUTSTR
       li   r0,>02c6
       li   r1,BACKT
       bl   @PUTSTR
       bl   @WAIT0
       b    @TANRET
TANASK li   r0,>0062
       li   r1,TANYES
       bl   @PUTSTR
       li   r0,>00a2
       li   r1,TANWARN
       bl   @PUTSTR
       li   r0,>00e2
       li   r1,TANW2
       bl   @PUTSTR
       li   r0,>0122
       li   r1,TANCONF
       bl   @PUTSTR
       li   r0,>0162
       li   r1,TANCONT
       bl   @PUTSTR
       li   r0,>02c6
       li   r1,BACKT
       bl   @PUTSTR
TANCK  bl   @KEYSCN
       mov  @KEYBUF,r0
       andi r0,>0100
       jne  TANONE
       mov  @KEYBUF,r0
       andi r0,>0200
       jne  TANCON
       mov  @KEYBUF+8,r0
       andi r0,>0100
       jeq  TANCK
       bl   @KEYREL
       b    @TANRET
TANONE clr  @RUNMOD
       jmp  TANRUN
TANCON li   r0,1
       mov  r0,@RUNMOD
TANRUN bl   @KEYREL
       clr  @BURNCT
TANAGN bl   @SCRINI
       li   r1,TANRNG
       bl   @PUTTTL
       li   r0,>0062
       li   r1,TANSTOP
       bl   @PUTSTR
       li   r0,>00a2
       li   r1,PASCTT
       bl   @PUTSTR
       li   r0,>00b4
       mov  @BURNCT,r1
       bl   @PUTHEX
       li   r0,>00e2
       li   r1,TANWIN
       bl   @PUTSTR
       li   r0,>00f0
       li   r1,>6000
       bl   @PUTHEX
       li   r0,FEXT
       szc  r0,@RESFLG
       clr  @ABORTF
       clr  @FAILAD
       clr  @FAILXP
       clr  @FAILAC
       clr  @FAILMS
       li   r0,>4487
       bl   @VDPREGW
       li   r8,>6000
       bl   @TANMB
       mov  @ABORTF,r0
       jne  TANABT
       mov  @RESFLG,r0
       andi r0,FEXT
       jne  TANRSL
       li   r0,>4787
       bl   @VDPREGW
       li   r0,>00f0
       li   r1,>c000
       bl   @PUTHEX
       li   r8,>c000
       bl   @TANMB
       mov  @ABORTF,r0
       jne  TANABT
       mov  @RESFLG,r0
       andi r0,FEXT
       jne  TANRSL
       inc  @BURNCT
       mov  @RUNMOD,r0
       jne  TANAGN
       jmp  TANRSL
TANABT bl   @KEYREL
TANRSL bl   @SCRINI
       li   r1,TANRTT
       bl   @PUTTTL
       li   r0,>0062
       li   r1,TANR1
       bl   @PUTSTR
       li   r0,>0077
       li   r1,PASSTX
       mov  @ABORTF,r2
       jeq  TANRRF
       li   r1,STOPTX
       jmp  TANRPS
TANRRF
       mov  @RESFLG,r2
       andi r2,FEXT
       jeq  TANRPS
       li   r1,FAILTX
TANRPS bl   @PUTSTR
       li   r0,>00a4
       li   r1,TANADT
       bl   @PUTSTR
       li   r0,>00b8
       mov  @FAILAD,r1
       bl   @PUTHEX
       li   r0,>00e4
       li   r1,TANMST
       bl   @PUTSTR
       li   r0,>00f8
       mov  @FAILMS,r1
       bl   @PUTHEX
       li   r0,>0142
       li   r1,TANRDON
       bl   @PUTSTR
       li   r0,>0184
       li   r1,PASCTT
       bl   @PUTSTR
       li   r0,>0196
       mov  @BURNCT,r1
       bl   @PUTHEX
       li   r0,>02c6
       li   r1,BACKT
       bl   @PUTSTR
       mov  @RESFLG,r0
       andi r0,FEXT
       jeq  TANRGR
       li   r0,>4687
       jmp  TANRBD
TANRGR li   r0,>4287
TANRBD bl   @VDPREGW
       bl   @WAIT0
TANRET mov  @MENURT,r11
       b    *r11

* R8 is the base of one 8 KiB window. Word accesses cover every byte.
TANMB  mov  r11,r13
       clr  @TSTPHS
       li   r0,>4487
       bl   @VDPREGW
       mov  r8,r4
       li   r5,>1000
       li   r7,>0100
TMB0   clr  *r4+
       dec  r5
       jeq  TMB0D
       dec  r7
       jne  TMB0
       bl   @POLL0
       mov  r0,r0
       jeq  TMB0C
       b    @TMBAB
TMB0C
       li   r7,>0100
       jmp  TMB0
TMB0D

* M1 ascending: r0,w1,r1,w0,r0,w1.
       li   r0,1
       mov  r0,@TSTPHS
       li   r0,>4787
       bl   @VDPREGW
       mov  r8,r4
       li   r5,>1000
       li   r7,>0100
TMB1   mov  *r4,r2
       clr  r6
       c    r6,r2
       jeq  TMB1A
       b    @TMBAD
TMB1A
       seto *r4
       mov  *r4,r2
       seto r6
       c    r6,r2
       jeq  TMB1B
       jmp  TMBAD
TMB1B
       clr  *r4
       mov  *r4,r2
       clr  r6
       c    r6,r2
       jeq  TMB1C
       jmp  TMBAD
TMB1C
       seto *r4
       inct r4
       dec  r5
       jeq  TMB1D
       dec  r7
       jne  TMB1
       bl   @POLL0
       mov  r0,r0
       jne  TMBAB
       li   r7,>0100
       jmp  TMB1
TMB1D

* M2 ascending: r1,w0,w1.
       li   r0,2
       mov  r0,@TSTPHS
       li   r0,>4587
       bl   @VDPREGW
       mov  r8,r4
       li   r5,>1000
       li   r7,>0100
TMB2   mov  *r4,r2
       seto r6
       c    r6,r2
       jne  TMBAD
       clr  *r4
       seto *r4
       inct r4
       dec  r5
       jeq  TMB2D
       dec  r7
       jne  TMB2
       bl   @POLL0
       mov  r0,r0
       jne  TMBAB
       li   r7,>0100
       jmp  TMB2
TMB2D

* M3 descending: r1,w0,w1,w0.
       li   r0,3
       mov  r0,@TSTPHS
       li   r0,>4a87
       bl   @VDPREGW
       mov  r8,r4
       ai   r4,>1ffe
       li   r5,>1000
       li   r7,>0100
TMB3   mov  *r4,r2
       seto r6
       c    r6,r2
       jne  TMBAD
       clr  *r4
       seto *r4
       clr  *r4
       dect r4
       dec  r5
       jeq  TMB3D
       dec  r7
       jne  TMB3
       bl   @POLL0
       mov  r0,r0
       jne  TMBAB
       li   r7,>0100
       jmp  TMB3
TMB3D

* M4 descending: r0,w1,w0.
       li   r0,4
       mov  r0,@TSTPHS
       li   r0,>4c87
       bl   @VDPREGW
       mov  r8,r4
       ai   r4,>1ffe
       li   r5,>1000
       li   r7,>0100
TMB4   mov  *r4,r2
       clr  r6
       c    r6,r2
       jne  TMBAD
       seto *r4
       clr  *r4
       dect r4
       dec  r5
       jeq  TMB4D
       dec  r7
       jne  TMB4
       bl   @POLL0
       mov  r0,r0
       jne  TMBAB
       li   r7,>0100
       jmp  TMB4
TMB4D
       li   r0,5
       mov  r0,@TSTPHS
       b    *r13
TMBAB  b    *r13
TMBAD  mov  r4,@FAILAD
       mov  r6,@FAILXP
       mov  r2,@FAILAC
       mov  r6,r3
       xor  r2,r3
       mov  r3,@FAILMS
       li   r3,FEXT
       soc  r3,@RESFLG
       b    *r13

MUSPG  mov  r11,r12
       bl   @SCRINI
       li   r1,MUSTTL
       bl   @PUTTTL
       li   r0,>0062
       li   r1,MUSL1
       bl   @PUTSTR
       li   r0,>00a2
       li   r1,MUSL2
       bl   @PUTSTR
       li   r0,>00e2
       li   r1,MUSL3
       bl   @PUTSTR
       li   r0,>0142
       li   r1,MUSL4
       bl   @PUTSTR
       li   r0,>02c6
       li   r1,BACKT
       bl   @PUTSTR
       b    *r12

* TMS9918A showcase: original pattern streaming, five same-scanline sprites,
* collision/overflow status capture, 8x8/16x16/magnified modes, and the scoped,
* approved MegaDemo bank-18 raster-wave adaptation documented below.
VDPSHW mov  r11,@MENURT
       clr  @VDPSTA
       bl   @SCRINI
       li   r1,VDPDTL
       bl   @PUTTTL
       li   r0,>0042
       li   r1,VDPDL1
       bl   @PUTSTR
       li   r0,>0062
       li   r1,VDPDL2
       bl   @PUTSTR
       li   r0,>0282
       li   r1,VDPDL3
       bl   @PUTSTR
       li   r0,>02c6
       li   r1,BACKT
       bl   @PUTSTR

* Eight animated tile patterns at character codes 128..135.
       li   r0,>0c00
       bl   @SETAW
       li   r1,DEMOPAT
       li   r2,64
VDPLDP movb *r1+,@VDPDAT
       inc  @VDPDLY
       dec  r2
       jne  VDPLDP
       li   r0,>00a1              * rows 5..18, preserving both frame columns
       li   r9,14
       li   r6,>8000
VDPFRW bl   @SETAW
       li   r2,30
VDPFLD movb r6,@VDPDAT
       inc  @VDPDLY
       ai   r6,>0100
       ci   r6,>8800
       jne  VDPFNC
       li   r6,>8000
VDPFNC dec  r2
       jne  VDPFLD
       ai   r0,32
       dec  r9
       jne  VDPFRW

* Five sprites deliberately share a scanline; the first pair overlap.
       bl   @LDSPAT
       li   r0,SABASE
       bl   @SETAW
       li   r1,DEMOAT
       li   r2,21
VDPLDA movb *r1+,@VDPDAT
       inc  @VDPDLY
       dec  r2
       jne  VDPLDA
       clr  r4
       clr  r6
VDPANM bl   @VDPVB
       inc  r4
       inc  r6
       andi r6,>00ff

* Stream one rotating pattern every frame.
       mov  r4,r7
       andi r7,7
       sla  r7,3
       ai   r7,DEMOFR
       li   r0,>0c00
       bl   @SETAW
       li   r2,8
VDPFRL movb *r7+,@VDPDAT
       inc  @VDPDLY
       dec  r2
       jne  VDPFRL

* Sprite pair 0/1 collides while moving; other sprites move in opposition.
       mov  r6,r1
       swpb r1
       li   r0,>0301
       bl   @VRW1
       mov  r6,r1
       swpb r1
       li   r0,>0305
       bl   @VRW1
       li   r1,>00ff
       s    r6,r1
       swpb r1
       li   r0,>0309
       bl   @VRW1
       mov  r6,r1
       ai   r1,64
       andi r1,>00ff
       swpb r1
       li   r0,>030d
       bl   @VRW1
       li   r1,>00bf
       s    r6,r1
       andi r1,>00ff
       swpb r1
       li   r0,>0311
       bl   @VRW1

       ci   r4,120
       jne  VDPS16
       li   r0,>c281              * 16x16 sprites
       bl   @VDPREGW
VDPS16 ci   r4,240
       jne  VDPEXT
       li   r0,>c381              * 16x16, 2x magnified
       bl   @VDPREGW
VDPEXT bl   @KEYSCN
       mov  @KEYBUF+8,r0
       andi r0,>0100
       jne  VDPDONE
       ci   r4,360
       jl   VDPANM
       bl   @VDPMDS

VDPDONE
       bl   @PSGMUT
       bl   @SCRINI
       li   r1,VDPRTL
       bl   @PUTTTL
       li   r0,>0062
       li   r1,VDPRL1
       bl   @PUTSTR
       li   r0,>0076
       li   r1,SEENTX
       mov  @VDPSTA,r2
       andi r2,>2000
       jne  VDPROK
       li   r1,NOTSEE
VDPROK bl   @PUTSTR
       li   r0,>00a2
       li   r1,VDPRL2
       bl   @PUTSTR
       li   r0,>00b6
       li   r1,SEENTX
       mov  @VDPSTA,r2
       andi r2,>4000
       jne  VDPFOK
       li   r1,NOTSEE
VDPFOK bl   @PUTSTR
       li   r0,>0102
       li   r1,VDPRL3
       bl   @PUTSTR
       li   r0,>0142
       li   r1,VDPRL4
       bl   @PUTSTR
       li   r0,>0182
       li   r1,VDPRL5
       bl   @PUTSTR
       li   r0,>02c6
       li   r1,BACKT
       bl   @PUTSTR
       bl   @WAIT0
       mov  @MENURT,r11
       b    *r11

* Poll a fresh VBlank and retain sprite collision/fifth-sprite status bits.
VDPVB  mov  r11,r14
VDPVBL clr  r0
       movb @VDPCTL,r0
       mov  r0,r1
       andi r1,>6000
       soc  r1,@VDPSTA
       andi r0,>8000
       jeq  VDPVBL
       b    *r14

* Cycle the remaining documented TMS9918A modes with original generated data.
VDPMDS mov  r11,r12

* 40-column Text mode, including the real lowercase glyph set.
       bl   @SCRINI
       clr  r0
       bl   @SETAW
       li   r1,>2000
       li   r2,>03c0
VDMTCL movb r1,@VDPDAT
       inc  @VDPDLY
       dec  r2
       jne  VDMTCL
       li   r0,>0005
       li   r1,VDMT1
       bl   @PUTSTR
       li   r0,>0052
       li   r1,VDMT2
       bl   @PUTSTR
       li   r0,>00a3
       li   r1,VDMT3
       bl   @PUTSTR
       li   r0,>00f2
       li   r1,VDMT4
       bl   @PUTSTR
       li   r0,>d081
       bl   @VDPREGW
       li   r5,120
       bl   @VDPHLD

* Multicolor mode: generated 4x4-cell color mosaic.
       li   r0,>8081
       bl   @VDPREGW
       clr  r0
       bl   @SETAW
       li   r2,>0300
       clr  r6
VDMMNM movb r6,@VDPDAT
       inc  @VDPDLY
       ai   r6,>0100
       dec  r2
       jne  VDMMNM
       li   r0,>0800
       bl   @SETAW
       li   r2,>0800
       li   r6,>2345
VDMMPT movb r6,@VDPDAT
       inc  @VDPDLY
       ai   r6,>1100
       dec  r2
       jne  VDMMPT
       li   r0,>c881
       bl   @VDPREGW
       li   r5,120
       bl   @VDPHLD

* Graphics-I raster wave adapted from the approved MegaDemo bank-18 effect.
* Eight name-table phases and paired transparent sprites let register 2/3
* changes follow the beam in eight-line bands instead of merely changing a
* completed frame. The silent showcase lasts three seconds; menu item 5 runs
* the same effect with the beat-aligned MegaDemo PSG passage.
       bl   @WAVINI
       li   r5,180
VDMWLP bl   @WAVFRM
       bl   @POLL0
       mov  r0,r0
       jne  VDMWDN
       dec  r5
       jne  VDMWLP
VDMWDN
       bl   @SCRINI
       b    *r12

* Build the striped field used by the bank-18 raster technique. Display stays
* off while the eight 1 KiB name-table phases and Graphics-I tables load.
WAVINI mov  r11,r13
       clr  @WFRAME
       clr  @WPHASE
       li   r1,WAVREG
       li   r2,8
WAVRLP mov  *r1+,r0
       bl   @VDPREGW
       dec  r2
       jne  WAVRLP

* Eight name-table pages: each column advances by eight character codes and
* each page offsets the starting code by one pixel phase.
       clr  r4
       clr  r5
       li   r6,8
WAVNPG mov  r4,r0
       bl   @SETAW
       li   r3,24
WAVNRW li   r2,32
       mov  r5,r1
WAVNCL movb r1,@VDPDAT
       inc  @VDPDLY
       ai   r1,>0800
       dec  r2
       jne  WAVNCL
       dec  r3
       jne  WAVNRW
       ai   r4,>0400
       ai   r5,>0100
       dec  r6
       jne  WAVNPG

* Shifted bitmap copies create the vertical strokes; the sparse Graphics-I
* color tables below supply the red/white/green phase sequence.
       li   r0,>2000
       bl   @SETAW
       li   r4,32
WAVTBL li   r1,>af00
       li   r5,>5f00
       li   r3,8
WAVTGP li   r2,4
WAVTPR movb r1,@VDPDAT
       inc  @VDPDLY
       movb r5,@VDPDAT
       inc  @VDPDLY
       dec  r2
       jne  WAVTPR
       srl  r1,1
       srl  r5,1
       dec  r3
       jne  WAVTGP
       dec  r4
       jne  WAVTBL

       li   r0,>2800
       bl   @SETAW
       li   r1,>ff00
       li   r2,32
WAVSPT movb r1,@VDPDAT
       inc  @VDPDLY
       dec  r2
       jne  WAVSPT

* Eight color-table phases at >3000,>3040,...,>31C0. Each 32-byte
* Graphics-I color table repeats one eight-byte phase four times. The unused
* 32 bytes between tables are deliberate; register 3 selects in >40-byte
* increments. This sparse layout is essential to the raster effect.
       li   r0,>3000
       li   r1,WAVPAT
       li   r6,8
WAVCPG bl   @SETAW
       li   r4,4
WAVCRP mov  r1,r7
       li   r2,8
WAVCWR movb *r7+,@VDPDAT
       inc  @VDPDLY
       dec  r2
       jne  WAVCWR
       dec  r4
       jne  WAVCRP
       ai   r0,>0040
       ai   r1,8
       dec  r6
       jne  WAVCPG

       li   r0,>e281              * display on, 16 KiB, Graphics I
       bl   @VDPREGW
       b    *r13

* Render one complete wavy frame. A VBlank starts the frame; two overlapping
* transparent sprites are then moved down in eight-line steps. Their collision
* bit is the beam-position reference used by the original MegaDemo technique.
* The bounded wait prevents an incompatible VDP clone from hanging the BIOS.
WAVFRM mov  r11,r13
       bl   @VDPVB
       mov  @WFRAME,r6
       andi r6,>0007
       jne  WAVPHS
       li   r0,>fff8
       a    r0,@WPHASE
WAVPHS mov  @WPHASE,r4
WAVBLP mov  r4,r1
       andi r1,>00ff
       sla  r1,1
       mov  @WAVSIN(r1),r1
       sra  r1,3

       mov  r1,r0
       andi r0,>0007
       swpb r0
       movb r0,@VDPCTL
       inc  @VDPDLY
       li   r2,>8200
       movb r2,@VDPCTL
       inc  @VDPDLY
       andi r1,>0038
       srl  r1,3
       ai   r1,>00c0
       swpb r1
       movb r1,@VDPCTL
       inc  @VDPDLY
       li   r2,>8300
       movb r2,@VDPCTL
       inc  @VDPDLY

       ci   r6,>00c0
       jhe  WAVBND
       mov  r6,r1
       swpb r1
       bl   @WAVSPR
       li   r14,>ffff
WAVCOL movb @VDPCTL,r0
       andi r0,>2000
       jne  WAVCDN
       dec  r14
       jne  WAVCOL
WAVCDN ai   r4,8
       ai   r6,8
       jmp  WAVBLP
WAVBND mov  @WFRAME,r1
       srl  r1,1
       andi r1,>01fe
       mov  @WAVSIN(r1),r1
       sra  r1,5
       a    r1,@WPHASE
       inc  @WFRAME
       mov  @WFRAME,r0
       andi r0,>03ff
       mov  r0,@WFRAME
       b    *r13

* R1 high byte is the collision scanline. The two color-zero 16x16 sprites
* overlap exactly; a third Y=>D0 record terminates the list.
WAVSPR mov  r11,r9
       li   r0,>3800
       bl   @SETAW
       ai   r1,>fe00
       li   r3,>ff00
       movb r1,@VDPDAT
       inc  @VDPDLY
       movb r3,@VDPDAT
       inc  @VDPDLY
       clr  r3
       movb r3,@VDPDAT
       inc  @VDPDLY
       movb r3,@VDPDAT
       inc  @VDPDLY
       movb r1,@VDPDAT
       inc  @VDPDLY
       li   r3,>ff00
       movb r3,@VDPDAT
       inc  @VDPDLY
       clr  r3
       movb r3,@VDPDAT
       inc  @VDPDLY
       movb r3,@VDPDAT
       inc  @VDPDLY
       li   r3,>d000
       movb r3,@VDPDAT
       inc  @VDPDLY
       movb @VDPCTL,r0            * discard stale collision; wait for a new one
       b    *r9

VDPHLD mov  r11,r13
VDPHLL bl   @VDPVB
       bl   @POLL0
       mov  r0,r0
       jne  VDPHDN
       dec  r5
       jne  VDPHLL
VDPHDN b    *r13

SCRINI mov  r11,r13
       bl   @VDPINI
       clr  r0
       bl   @SETAW
       li   r1,>2000              * ASCII space
       li   r2,>0300
SCRCL  movb r1,@VDPDAT
       inc  @VDPDLY
       dec  r2
       jne  SCRCL
       li   r0,>0900              * pattern slot 32
       bl   @SETAW
       li   r1,FONT
       li   r2,>0300              * ASCII 32..127, including true lowercase
SCRFN  movb *r1+,@VDPDAT
       inc  @VDPDLY
       dec  r2
       jne  SCRFN
       li   r0,>0880              * private characters >10..>15
       bl   @SETAW
       li   r1,FRAMEG
       li   r2,48                 * rounded TL/TR/BL/BR, horizontal, vertical
SCRFG  movb *r1+,@VDPDAT
       inc  @VDPDLY
       dec  r2
       jne  SCRFG
       li   r0,>08b0              * private bold menu numerals >16..>1D
       bl   @SETAW
       li   r1,ACKGLY
       li   r2,64
SCRAG  movb *r1+,@VDPDAT
       inc  @VDPDLY
       dec  r2
       jne  SCRAG
       li   r0,CTBASE
       bl   @SETAW
       li   r1,COLORS
       li   r2,32
SCRCO  movb *r1+,@VDPDAT
       inc  @VDPDLY
       dec  r2
       jne  SCRCO
* Ordinary pages must never inherit a diagnostic/demo sprite. Terminate the
* sprite list explicitly; the VDP showcase loads its own patterns/attributes.
       li   r0,SABASE
       li   r1,>d000
       bl   @VRW1
       li   r0,>c081              * 16K, display on, VDP IRQ disabled
       bl   @VDPREGW
       bl   @SCRFRM               * consistent professional frame on all pages
       b    *r13

* Fixed 32x24 page frame using private joined-line glyphs >10..>15. Keeping
* their codes below >80 lets a D7-stuck-low fault page retain its border.
* Titles interrupt the rail; square corners avoid a composite-visible shelf.
SCRFRM mov  r11,r10
       clr  r0
       bl   @SETAW
       li   r1,>1000              * square top-left
       movb r1,@VDPDAT
       inc  @VDPDLY
       li   r1,>1400              * joined horizontal rail
       li   r2,30
SCRFT1 movb r1,@VDPDAT
       inc  @VDPDLY
       dec  r2
       jne  SCRFT1
       li   r1,>1100              * square top-right
       movb r1,@VDPDAT
       inc  @VDPDLY
       li   r0,>02e0              * row 23
       bl   @SETAW
       li   r1,>1200              * square bottom-left
       movb r1,@VDPDAT
       inc  @VDPDLY
       li   r1,>1400
       li   r2,30
SCRFB1 movb r1,@VDPDAT
       inc  @VDPDLY
       dec  r2
       jne  SCRFB1
       li   r1,>1300              * square bottom-right
       movb r1,@VDPDAT
       inc  @VDPDLY
       li   r6,>0020              * rows 1..22, columns 0 and 31
       li   r8,22
SCRFSD mov  r6,r0
       li   r1,>1500              * joined vertical rail
       bl   @VRW1
       ai   r0,31
       bl   @VRW1
       ai   r6,32
       dec  r8
       jne  SCRFSD
       b    *r10

LDSPAT mov  r11,r10
       li   r0,SPBASE
       bl   @SETAW
       li   r1,SPRITE
       li   r2,32
LDSP1  movb *r1+,@VDPDAT
       inc  @VDPDLY
       dec  r2
       jne  LDSP1
       b    *r10

* Clear a pending status bit, then require a new VBlank status transition.
* The TP1000 VDP INT pin is unconnected, so this deliberately polls status.
TIMTST movb @VDPCTL,r0
       li   r1,>ffff
TIMLP  movb @VDPCTL,r0
       andi r0,>8000
       jne  TIMOK
       dec  r1
       jne  TIMLP
       li   r0,FTIME
       soc  r0,@RESFLG
       clr  @TIMFLG
       rt
TIMOK  li   r0,1
       mov  r0,@TIMFLG
       rt

SUMMARY mov r11,r12
       li   r1,SYSRTT
       bl   @PUTTTL
       li   r0,>0022
       li   r1,VERST
       bl   @PUTSTR
       li   r0,>0062
       li   r1,REGIONT
       bl   @PUTSTR
       li   r0,>006c
       .ifeq REGION,>0000
       li   r1,TUTORT
       .else
       li   r1,PYUUTT
       .endif
       bl   @PUTSTR
       li   r0,>00a2
       li   r1,CPUTX
       bl   @PUTSTR
       li   r0,>00b8
       li   r1,PASSTX
       mov  @RESFLG,r2
       andi r2,FCPU
       jeq  SUMCP
       li   r1,FAILTX
SUMCP  bl   @PUTSTR
       li   r0,>00c2
       li   r1,RAMTX
       bl   @PUTSTR
       li   r0,>00d8
       li   r1,PASSTX
       mov  @RESFLG,r2
       andi r2,FRAM
       jeq  SUMRA
       li   r1,FAILTX
SUMRA  bl   @PUTSTR
       li   r0,>00e2
       li   r1,ROMTX
       bl   @PUTSTR
       li   r0,>00f8
       li   r1,PASSTX
       mov  @RESFLG,r2
       andi r2,FROM
       jeq  SUMRO
       li   r1,FAILTX
SUMRO  bl   @PUTSTR
       li   r0,>0102
       li   r1,ROMSUT
       bl   @PUTSTR
       li   r0,>0113
       mov  @ROMSUM,r1
       bl   @PUTHEX
       li   r0,>0117
       li   r1,SLASHT
       bl   @PUTSTR
       li   r0,>0118
       mov  @ROMSM2,r1
       bl   @PUTHEX
       li   r0,>0142
       li   r1,VDPTX
       bl   @PUTSTR
       mov  @RESFLG,r2
       andi r2,FVDP
       jeq  SUMVP
       li   r0,>0158
       li   r1,FAILTX
       bl   @PUTSTR
       jmp  SUMVX
SUMVP  li   r0,>0158
       li   r1,PASSTX
       bl   @PUTSTR
SUMVX  li   r0,>0162
       li   r1,VADRTX
       bl   @PUTSTR
       li   r0,>0178
       mov  @FAILAD,r1
       bl   @PUTHEX
       li   r0,>0182
       li   r1,VMASKT
       bl   @PUTSTR
       li   r0,>0198
       mov  @FAILMS,r1
       bl   @PUTHEX
       li   r0,>01a2
       li   r1,TIMETX
       bl   @PUTSTR
       li   r0,>01b8
       li   r1,PASSTX
       mov  @TIMFLG,r2
       jne  SUMTM
       li   r1,FAILTX
SUMTM  bl   @PUTSTR
       li   r0,>01e2
       li   r1,MAP0TX
       bl   @PUTSTR
       li   r0,>01f4
       li   r1,DIAGMP
       bl   @PUTSTR
       li   r0,>0202
       li   r1,MAPXTX
       bl   @PUTSTR
       li   r0,>0217
       li   r1,NORWTX
       mov  @EXTFLG,r2
       jeq  SUMMP
       li   r0,>0215
       li   r1,RWRWTX
SUMMP  bl   @PUTSTR
       li   r0,>0222
       li   r1,EXTTXT
       bl   @PUTSTR
       mov  @EXTFLG,r2
       jne  SUMETN
       li   r0,>022f
       li   r1,NOEXTT
       jmp  SUMEX
SUMETN li   r0,>022c
       li   r1,TANAMT
SUMEX  bl   @PUTSTR
       li   r0,>02c2
       li   r1,BACKT
       bl   @PUTSTR
       mov  @RESFLG,r0
       jne  SUMRED
       li   r0,>4287              * green border on all automatic passes
       jmp  SUMBRD
SUMRED li   r0,>4687
SUMBRD bl   @VDPREGW
       b    *r12

* Scan all eight keyboard-matrix rows and update four compact row-pair displays.
KEYUPD mov  r11,r13
       bl   @KEYSCN
       bl   @KEYDEC
       li   r6,KEYBUF
       li   r7,KEYPOS
       li   r8,8
KEYDSP mov  *r6+,r1
       srl  r1,8
       mov  *r7+,r0
       bl   @PUTHEX
       dec  r8
       jne  KEYDSP
       b    *r13

* Raw scan without presentation side effects, used by every menu and page.
KEYSCN mov  r11,r14
       li   r12,>ec00
       li   r8,KEYBUF
       li   r9,8
KEYULP clr  r0
       stcr r0,8
       mov  r0,*r8+
       ai   r12,>0010
       dec  r9
       jne  KEYULP
       b    *r14

* Latch the first asserted contact so a short/bouncing key remains readable.
* The fixed 16-byte label also includes the electrically observed row/bit.
KEYDEC mov  r11,r15
       li   r6,KEYBUF
       clr  r4                    * row
KEYDRW mov  *r6+,r0
       srl  r0,8
       jne  KEYDBT
       inc  r4
       ci   r4,8
       jne  KEYDRW
       clr  @KEYHELD
       b    *r15
KEYDBT clr  r5                    * bit
       li   r1,1
KEYDBL coc  r1,r0
       jeq  KEYDFD
       sla  r1,1
       inc  r5
       jmp  KEYDBL
KEYDFD mov  r4,r3
       sla  r3,3
       a    r5,r3                 * decoded index 0..63
       mov  r3,r2
       inc  r2                    * zero remains the no-key sentinel
       c    r2,@KEYHELD
       jeq  KEYDOLD
       mov  r2,@KEYHELD
       inc  @KEYCNT
KEYDOLD
       mov  r3,r7                 * preserve 0..63 index for Shift decoding
       sla  r3,4                  * fixed label size = 16
       ai   r3,KEYNAM
       li   r0,>0088
       mov  r3,r1
       li   r2,16
       bl   @PUTFIX
       mov  @KEYMODE,r0
       jeq  KEYDNS
       mov  r7,r3
       sla  r3,3
       ai   r3,PCNAM
       li   r0,>0088
       mov  r3,r1
       li   r2,8
       bl   @PUTFIX
KEYDNS
       mov  @KEYBUF+12,r0
       andi r0,>0400              * native Shift contact R6B2
       jeq  KEYDNM
       sla  r7,3                  * eight-byte shifted key name
       ai   r7,KEYSHF
       mov  @KEYMODE,r0
       jeq  KEYDSH
       ai   r7,PCSHF-KEYSHF
KEYDSH
       li   r0,>0088
       mov  r7,r1
       li   r2,8
       bl   @PUTFIX
KEYDNM
       li   r0,>009a
       mov  @KEYCNT,r1
       bl   @PUTHEX
       b    *r15

KEYPOS data >0105,>010d,>0145,>014d
       data >0185,>018d,>01c5,>01cd
JOY1PS data >0122,>0127,>012a,>012d,>0130
JOY2PS data >01e2,>01e7,>01ea,>01ed,>01f0
JOYMASK data >0400,>2000,>8000,>1000,>4000
CHIPPS data >00e2,>00f2,>0142,>0152
       data >01a2,>01b2,>0202,>0212

VDPREGW
       movb r0,@VDPCTL
       inc  @VDPDLY
       swpb r0
       movb r0,@VDPCTL
       inc  @VDPDLY
       rt

* Center a length-prefixed title on the 32-column top rail. Odd spare columns
* leave the extra cell on the right, matching every other centered page item.
PUTTTL mov  r11,r15
       clr  r0
       movb *r1,r0
       srl  r0,8
       li   r2,32
       s    r0,r2
       srl  r2,1
       mov  r2,r0
       bl   @PUTSTR
       b    *r15

PUTSTR mov  r11,r14
       bl   @SETAW
       clr  r2
       movb *r1+,r2
       srl  r2,8
       jeq  PUTSRT
PUTSLP movb *r1+,@VDPDAT
       inc  @VDPDLY
       dec  r2
       jne  PUTSLP
PUTSRT b    *r14

* R0=VRAM address, R1=ROM pointer, R2=exact byte count.
PUTFIX mov  r11,r14
       bl   @SETAW
PUTFLP movb *r1+,@VDPDAT
       inc  @VDPDLY
       dec  r2
       jne  PUTFLP
       b    *r14

PUTHEX mov  r11,r14
       mov  r1,r10
       bl   @SETAW
       li   r2,4
HEXLP  mov  r10,r3
       andi r3,>f000
       srl  r3,12
       movb @HEXDIG(r3),@VDPDAT
       inc  @VDPDLY
       sla  r10,4
       dec  r2
       jne  HEXLP
       b    *r14

* ---------------------------------------------------------------------------
* Audio feedback
* ---------------------------------------------------------------------------

PSGMUT li   r0,>9f00
       movb r0,@SNDOUT
       li   r0,>bf00
       movb r0,@SNDOUT
       li   r0,>df00
       movb r0,@SNDOUT
       li   r0,>ff00
       movb r0,@SNDOUT
       rt

BOOTBP mov  r11,r10
       li   r0,>8600
       movb r0,@SNDOUT
       li   r0,>1200
       movb r0,@SNDOUT
       li   r0,>9000
       movb r0,@SNDOUT
       bl   @SNDDEL
       bl   @PSGMUT
       b    *r10

PASSBP mov  r11,r10
       li   r0,>8800
       movb r0,@SNDOUT
       li   r0,>0800
       movb r0,@SNDOUT
       li   r0,>9100
       movb r0,@SNDOUT
       bl   @SNDDEL
       li   r0,>8400
       movb r0,@SNDOUT
       bl   @SNDDEL
       bl   @PSGMUT
       b    *r10

FAILBP mov  r11,r10
       li   r0,>e700              * noise control + audible noise volume
       movb r0,@SNDOUT
       li   r0,>f200
       movb r0,@SNDOUT
       bl   @SNDDEL
       bl   @PSGMUT
       b    *r10

* Audible channel walk: tones 0, 1, 2, then noise.  Listening is the test.
PSGTST mov  r11,r10
       li   r2,PSGSEQ
       li   r3,4
PSGSLP movb *r2+,@SNDOUT
       movb *r2+,@SNDOUT
       movb *r2+,@SNDOUT
       bl   @SNDDEL
       bl   @PSGMUT
       dec  r3
       jne  PSGSLP
       b    *r10

* MegaDemo high-energy PSG excerpt and bank-18 raster wave. The 224-frame
* phrase begins/ends at identical PSG state on a musical beat; eight repeats
* run 29.897 seconds at 60000/1001 Hz. Jon reports permission granted for
* Pyuuta/Tutor and TI diagnostic hardware (2026-09-01).
PSGMUS mov  r11,r10
       clr  @ABORTF
       bl   @PSGMUT
       bl   @WAVINI
       li   r7,8
MUSREP
       li   r5,MDPSG
MUSNXT clr  r8
       movb *r5+,r8              * frame delay
       jeq  MUSRPT               * zero terminates one phrase
       srl  r8,8
MUSDLY bl   @WAVFRM
       bl   @POLL0
       mov  r0,r0
       jne  MUSEND
       dec  r8
       jne  MUSDLY
       clr  r6
       movb *r5+,r6              * raw PSG byte count
       srl  r6,8
MUSWRT movb *r5+,@SNDOUT
       inc  @VDPDLY              * also spaces writes for the faster TMS9995
       dec  r6
       jne  MUSWRT
       jmp  MUSNXT
MUSRPT
       dec  r7
       jne  MUSREP
MUSEND
       bl   @PSGMUT
       b    *r10

SNDDEL li   r1,>4000
SNDDLP dec  r1
       jne  SNDDLP
       rt

PSGSEQ byte >88,>10,>90             * channel 0
       byte >a8,>10,>b0             * channel 1
       byte >c8,>10,>d0             * channel 2
       byte >e4,>00,>f0             * periodic noise
       even

* MegaDemo high-energy PSG loop from global capture frames 16820..17044.
* The first event restores the complete boundary state before applying frame
* 16822. The state at 17044 exactly matches 16820, making all eight repeats
* beat- and register-continuous. Format is delay, count, raw PSG bytes; zero ends.
MDPSG
       byte >02,>0c,>80,>0f,>90,>a0,>0f,>b7,>c9,>09,>df,>e3,>f4,>92
       byte >02,>01,>93

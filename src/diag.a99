VDPREG data >0080,>8081,>0082,>0e83
       data >0184,>0685,>0386,>4f87
* Graphics-I colors are per group of eight patterns. ASCII 32..127 is kept
* consistently dark blue on white; the upper groups are reserved for demos.
COLORS byte >4f,>4f,>4f,>4f,>4f,>4f,>4f,>4f
       byte >4f,>4f,>4f,>4f,>4f,>4f,>4f,>4f
       byte >5f,>7f,>2f,>af,>cf,>6f,>8f,>df
       byte >4f,>4f,>4f,>4f,>4f,>4f,>4f,>4f
* MegaDemo bank-18 raster-wave assets, adapted under Jon's reported scoped
* permission for Pyuuta/Tutor and TI diagnostic hardware. WAVREG first blanks
* the display while the tables load; WAVINI enables it with register 1=>E2.
* Bank 18 uses Graphics I (R0=>00), not Graphics II. R4 selects the pattern
* table at >2000 and R3 selects one of the color tables at >3000..>31C0.
WAVREG data >0080,>a281,>0082,>c083
       data >0484,>7085,>0586,>0087
WAVPAT byte >6f,>86,>98,>e9,>ce,>2c,>32,>f3
       byte >f3,>6f,>86,>98,>e9,>ce,>2c,>32
       byte >32,>f3,>6f,>86,>98,>e9,>ce,>2c
       byte >2c,>32,>f3,>6f,>86,>98,>e9,>ce
       byte >ce,>2c,>32,>f3,>6f,>86,>98,>e9
       byte >e9,>ce,>2c,>32,>f3,>6f,>86,>98
       byte >98,>e9,>ce,>2c,>32,>f3,>6f,>86
       byte >86,>98,>e9,>ce,>2c,>32,>f3,>6f
* Original 256-word signed sine used by the approved bank-18 raster routine.
* Keeping word precision preserves both the per-band displacement and the
* slower phase-acceleration envelope; the earlier 64-byte approximation did
* neither faithfully enough for physical TMS9918 timing.
WAVSIN data >0000,>0006,>000d,>0013,>0019,>001f,>0026,>002c
       data >0032,>0038,>003e,>0044,>004a,>0050,>0056,>005c
       data >0062,>0068,>006d,>0073,>0079,>007e,>0084,>0089
       data >008e,>0093,>0098,>009d,>00a2,>00a7,>00ac,>00b1
       data >00b5,>00b9,>00be,>00c2,>00c6,>00ca,>00ce,>00d1
       data >00d5,>00d8,>00dc,>00df,>00e2,>00e5,>00e7,>00ea
       data >00ed,>00ef,>00f1,>00f3,>00f5,>00f7,>00f8,>00fa
       data >00fb,>00fc,>00fd,>00fe,>00fe,>00fe,>00ff,>00ff
       data >00ff,>00ff,>00ff,>00fe,>00fe,>00fe,>00fd,>00fc
       data >00fb,>00fa,>00f8,>00f7,>00f5,>00f3,>00f1,>00ef
       data >00ed,>00ea,>00e7,>00e5,>00e2,>00df,>00dc,>00d8
       data >00d5,>00d1,>00ce,>00ca,>00c6,>00c2,>00be,>00b9
       data >00b5,>00b1,>00ac,>00a7,>00a2,>009d,>0098,>0093
       data >008e,>0089,>0084,>007e,>0079,>0073,>006d,>0068
       data >0062,>005c,>0056,>0050,>004a,>0044,>003e,>0038
       data >0032,>002c,>0026,>001f,>0019,>0013,>000d,>0006
       data >0000,>fffa,>fff3,>ffed,>ffe7,>ffe1,>ffda,>ffd4
       data >ffce,>ffc8,>ffc2,>ffbc,>ffb6,>ffb0,>ffaa,>ffa4
       data >ff9e,>ff98,>ff93,>ff8d,>ff87,>ff82,>ff7c,>ff77
       data >ff72,>ff6d,>ff68,>ff63,>ff5e,>ff59,>ff54,>ff4f
       data >ff4b,>ff47,>ff42,>ff3e,>ff3a,>ff36,>ff32,>ff2f
       data >ff2b,>ff28,>ff24,>ff21,>ff1e,>ff1b,>ff19,>ff16
